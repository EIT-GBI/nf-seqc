manifest {
    name            = 'nf-seqc'
    description     = 'Batch-level QC for Illumina NextSeq, Element AVITI, Nanopore P24 and PacBio Revio sequencing runs'
    version         = '0.0.0'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    // The modules are git submodules. Without this, `nextflow run
    // EIT-GBI/nf-seqc -r vX.Y.Z` checks out an empty modules/ and every
    // include fails.
    recurseSubmodules = true
}

params {
    // One pipeline run = one sequencing run, named one of two ways:
    //
    //  - `--instrument <brand>_<model>_<machine_ID> --run <run folder>`: the
    //    production route. The run is looked up as
    //    <prep_root>/<instrument>/<YYYY>/<run>, and results are published to
    //    the same relative path under <publish_root>, so scientists find a run
    //    by the name the instrument gave it. See "Run location" at the end of
    //    this file.
    //  - `--input <run_dir>`: any run directory, results to --outdir.
    //
    // Either way the input is the instrument's complete run output directory,
    // not a samplesheet or a FASTQ glob.
    input        = null
    instrument   = null   // e.g. illumina_nextseq_VH02427
    run          = null   // the run folder name, e.g. 261006_VH02427_108_AAJJW55M5
    prep_root    = '/mnt/instrument-prep-zone/sequencing'  // where instruments write
    publish_root = '/mnt/instrument-data/sequencing'       // where scientists read
    platform = null   // auto-detected from marker files; override with illumina|aviti|nanopore|pacbio
    run_id   = null   // defaults to the run directory name
    outdir   = null   // defaults to <publish_root>/<instrument>/<YYYY>/<run>, or 'results' with --input
    // A run is published once: the pipeline refuses to write into an output
    // directory that already has files in it, unless resuming (-resume) or
    // told to with --overwrite.
    overwrite = false

    // Overrides for when reads do not sit in their instrument-default location.
    fastq_dir = null  // Illumina: directory holding *_R1_001.fastq.gz
    pod5_dir  = null  // Nanopore: directory tree holding *.pod5
    barcode_kit = null // Nanopore: barcoding kit, if final_summary does not name it (e.g. SQK-RBK114-24)
    // Nanopore: a barcode needs this many reads to be reported as a sample.
    // Unused barcodes each pick up a read or two from misclassification.
    min_barcode_reads = 100
    bam_dir   = null  // PacBio: directory holding *.hifi_reads*.bam

    // Undetermined/Unassigned (Illumina, AVITI) and unclassified (Nanopore)
    // reads are always delivered, but left out of per-sample QC unless these
    // are set. include_failed also basecalls ONT pod5_fail. PacBio unassigned
    // HiFi BAMs are always delivered and never QC'd.
    include_undetermined = false
    include_failed       = false

    // Illumina: run-level metrics are only meaningful once RTAComplete.txt and
    // CopyComplete.txt exist. Set true to report on a run anyway.
    allow_incomplete = false

    // Illumina: flag the run in the report (and warn) when more than this
    // percentage of reads is Undetermined.
    max_undetermined = 15

    // ONT basecalling — consumed by nf-mod-dorado/basecaller. Models are baked
    // into the dorado image under /opt/models so POD5 runs stay offline-safe.
    basecall {
        model          = '/opt/models/dna_r10.4.1_e8.2_400bps_sup@v5.0.0'
        modified_bases = null   // e.g. '5mCG_5hmCG' to emit MM/ML methylation tags
    }

    multiqc_config = null
}

includeConfig 'conf/base.config'

// ---------------------------------------------------------------------------
// Module containers
// ---------------------------------------------------------------------------
// Each released module declares the image it was built from, in its own
// conf/module.config, pinned to that module's release version. Nextflow does
// not read a submodule's config on its own, so each is included explicitly.
// No image here is ever `:latest`; only -profile dev points back at it.
//
// These come before `profiles`, so -profile dev can override them.
includeConfig 'modules/fastqc/conf/module.config'
includeConfig 'modules/interop/conf/module.config'
includeConfig 'modules/dorado/conf/module.config'

// INTEROP_RUN_METRICS runs a script shipped in its module's resources/usr/bin/,
// which Nextflow stages and puts on PATH only with module binaries enabled.
nextflow.enable.moduleBinaries = true

process {
    // --kit-name makes the basecaller tag each read with its barcode, which
    // DORADO_DEMUX then splits on (--no-classify). It must come before
    // --modified-bases, which swallows every following non-flag argument.
    // --models-directory lets dorado find the modified-base models baked into
    // the image instead of downloading them.
    withName: 'DORADO_BASECALLER' {
        ext.args = { [
            meta.kit ? "--kit-name ${meta.kit}" : '',
            params.basecall.modified_bases ? "--models-directory /opt/models --modified-bases ${params.basecall.modified_bases}" : '',
        ].findAll { a -> a }.join(' ') }
    }
    // The basecaller already trimmed the barcodes.
    withName: 'DORADO_DEMUX' {
        ext.args = '--no-classify --no-trim --emit-summary'
    }
}

profiles {
    // Test against unreleased module changes: the module configs pin an image
    // version that only exists once that module is released, so point every
    // module back at :latest.
    dev {
        process {
            withName: 'FASTQC_.*'   { container = 'ghcr.io/eit-gbi/nf-mod-fastqc:latest'   }
            withName: 'DORADO_.*'   { container = 'ghcr.io/eit-gbi/nf-mod-dorado:latest'   }
            withName: 'INTEROP_.*'  { container = 'ghcr.io/eit-gbi/nf-mod-interop:latest'  }
        }
    }
    docker {
        docker.enabled = true
        process {
            withName: 'DORADO_BASECALLER' {
                containerOptions = '--gpus all'
            }
        }
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // Every container gets its own /dev/shm (--contain). Nextflow starts
        // Singularity/Apptainer with --pid, so a tool has the same PID in every
        // container, and Intel OpenMP (libiomp5, bundled with dorado) registers
        // itself at start-up as /dev/shm/__KMP_REGISTERED_LIB_<pid>_<uid>. On
        // the node's shared /dev/shm, two tasks starting together race on that
        // one file and one aborts: `OMP: Error #15 ... unknown library already
        // initialized` (exit 134) or a bus error (exit 135). See
        // EIT-GBI/nf-seqc#10. --contain alone would also swap /tmp for a 64 MB
        // tmpfs, so the host /tmp and /var/tmp are bound back. Set here rather
        // than per process so containerOptions cannot drop it. Docker already
        // gives each container a private /dev/shm.
        singularity.runOptions = '--contain -B /tmp -B /var/tmp'
        process {
            withName: 'DORADO_BASECALLER' {
                containerOptions = '--nv'
            }
        }
    }
    // GBI sandpit SLURM (sandpit-tokyo: `cpu` + `gpu` partitions; sandpit-osaka:
    // `cpu` only). Self-contained, as in nf-dnaseq: it switches Apptainer on
    // itself, so use `-profile cluster` alone. Submit the Nextflow head job
    // itself with sbatch, because on tokyo Apptainer exists only on the compute
    // nodes; see "Running on the GBI cluster" in the README.
    cluster {
        docker.enabled       = false
        apptainer.enabled    = true
        apptainer.autoMounts = true
        // Shared house cache, also used by nf-dnaseq: images pulled once are
        // reused by everyone.
        apptainer.cacheDir   = '/mnt/lustre/containers/.staging/nf/cache/'
        apptainer.pullTimeout = 2.h
        // A private /dev/shm per container; see the singularity profile.
        apptainer.runOptions  = '--contain -B /tmp -B /var/tmp'
        process {
            executor = 'slurm'
            queue    = 'cpu'
            // GPU nodes expose gpu:h100:8; keep the count equal to `accelerator`
            // in conf/base.config.
            withName: 'DORADO_BASECALLER' {
                queue            = 'gpu'
                clusterOptions   = '--gres=gpu:1'
                containerOptions = '--nv'
            }
        }
    }
    test {
        includeConfig 'conf/test.config'
    }
    test_aviti {
        includeConfig 'conf/test.config'
        params.input = "${projectDir}/assets/test/aviti_run"
    }
    test_nanopore {
        includeConfig 'conf/test.config'
        params.input = "${projectDir}/assets/test/nanopore_run"
    }
    test_pacbio {
        includeConfig 'conf/test.config'
        params.input = "${projectDir}/assets/test/pacbio_run"
    }
    // The --instrument/--run route: the Illumina fixture filed under a mock
    // prep zone (a symlink), results mirrored under results-test-publish/.
    test_publish {
        includeConfig 'conf/test.config'
        params.input        = null
        params.outdir       = null
        params.instrument   = 'illumina_nextseq_VH00000'
        params.run          = 'illumina_run'
        params.prep_root    = "${projectDir}/assets/test/prep_zone"
        params.publish_root = 'results-test-publish'
    }
    // Real miniaturised runs on sandpit-tokyo, so the tools themselves run.
    // Cluster only (not CI); combine with the cluster profile:
    //     -profile cluster,test_real_nanopore
    // See conf/test_real.config for what each fixture holds.
    test_real_illumina {
        includeConfig 'conf/test_real.config'
        params.input = '/mnt/lustre/users/pauline-fourgoux/fixtures/nextseq-mini/261006_VH02427_108_AAJJW55M5'
    }
    test_real_aviti {
        includeConfig 'conf/test_real.config'
        params.input = '/mnt/instrument-data/element_aviti_1/20260924_GBI-Elements_SEQEBA000015'
        // Two tiles, one per lane (~13 min). bases2fastq 2.4.0 ignores
        // --include-tile; --exclude-tile with a lookahead works.
        process {
            withName: 'BASES2FASTQ' {
                ext.args = '--exclude-tile "^(?!L[12]R06C01S1$).*$"'
            }
        }
    }
    test_real_nanopore {
        includeConfig 'conf/test_real.config'
        params.input = '/mnt/lustre/users/pauline-fourgoux/fixtures/p24-mini/20260515_Plasmids_A_B'
    }
    test_real_pacbio {
        includeConfig 'conf/test_real.config'
        params.input = '/mnt/lustre/users/pauline-fourgoux/fixtures/revio-mini/r84334_20260817_141703'
    }
}

// ---------------------------------------------------------------------------
// Local module containers
// ---------------------------------------------------------------------------
// modules/local/ tools are not submodules, so their images are declared here
// rather than in a modules/*/conf/module.config. Every tag is pinned.
process {
    withName: 'BASES2FASTQ' {
        container = 'elembio/bases2fastq:2.4.0'
    }
    // Standard-library Python only (ont_summary_stats.py, pacbio_cell_qc.py).
    withName: 'ONT_SUMMARY_STATS|PACBIO_CELL_QC' {
        container = 'python:3.12.7-slim'
    }
    // samtools quickcheck + view (BAM_CHECK): nf-mod-samtools' image, pinned
    // to its release as the nf-mod modules are.
    withName: 'BAM_CHECK' {
        container = 'ghcr.io/eit-gbi/nf-mod-samtools:v1.2.0'
    }
    withName: 'MULTIQC' {
        container = 'quay.io/biocontainers/multiqc:1.35--pyhdfd78af_2'
    }
}

// ---------------------------------------------------------------------------
// Run location
// ---------------------------------------------------------------------------
// Instruments write to <prep_root>/<instrument>/<YYYY>/<run>. With --instrument
// and --run, find the year directory holding the run, so it need not be given:
// every match is listed (comma-separated) and main.nf fails unless there is
// exactly one. Done here rather than in main.nf because outputDir, below, is
// built from it, and outputDir must be known before the workflow starts.
// Internal: kept apart from params.input, so main.nf can tell a --input the
// user gave (refused alongside --instrument/--run) from this lookup.
params.run_matches = params.instrument && params.run
    ? ( new File( "${params.prep_root}/${params.instrument}" ).listFiles() ?: [] )
        .findAll { year -> new File( year, params.run ).isDirectory() }
        .collect { year -> new File( year, params.run ).path }
        .sort()
        .join(',')
    : null

// Base directory for the workflow `output {}` block: --outdir if given, else
// the run's mirror under <publish_root> (with --instrument/--run), else
// 'results'. Must come AFTER the profiles block: profiles are merged as they
// are parsed, so assigning this earlier would capture the default
// `params.outdir` and silently ignore any profile that overrides it.
// Override on the CLI with `-output-dir <path>` or via `--outdir <path>`.
outputDir = params.outdir ?: (
    params.run_matches && !params.run_matches.contains(',')
        ? "${params.publish_root}/${params.instrument}/${new File( params.run_matches ).parentFile.name}/${params.run}"
        : 'results'
)

// Copies, not links. <publish_root> is a different filesystem from work/, so
// hard links cannot reach it, and symlinks would empty the results the moment
// work/ is cleaned. Costs a second copy of the reads until work/ is removed.
workflow.output.mode = 'copy'
