# Source of truth for nf-mod-* submodule versions.
# Renovate reads this file and proposes updates when new releases exist.
# The post-merge sync workflow then moves the actual submodule pointer to match.
#
# Format (one per line):
#   <module-repo-name>=<version-tag>
#
# The module-repo-name must match the GitHub repo name exactly (e.g. nf-mod-fastqc).
# The version-tag must match a published release tag in that repo (e.g. v1.2.3).

nf-mod-fastqc=3.0.0
nf-mod-samtools=1.0.0
nf-mod-interop=1.3.0

# BLOCKED: nf-mod-dorado has no git tag or published release, so there is
# nothing for the sync workflow to check out. Its submodule tracks the default
# branch, so the pipeline is not reproducible on dorado. Cut a release, then add:
#   nf-mod-dorado=<version>
#
# Also pending: bases2fastq and multiqc live in modules/local/ because
# no nf-mod-* repo exists for them yet. nanoplot is local until nf-mod-nanoplot
# accepts unaligned input and has a release.
