// Minimal test profile — small inputs for CI / smoke runs.
//
// The fixtures under assets/test/ are marker files and zero-byte reads: enough
// to exercise platform detection, sample discovery and channel wiring under
// `-stub`, but NOT valid instrument data. Run them stubbed:
//
//     nextflow run . -profile test -stub
//     nextflow run . -profile test_nanopore -stub
//
// TODO: replace with real miniaturised runs (or public URLs) once available, so
// the tools themselves are exercised and not just the wiring.

params {
    input  = "${projectDir}/assets/test/illumina_run"
    outdir = 'results-test'
}

// Cap rather than override: the withLabel blocks in conf/base.config are more
// specific than a bare `cpus = 1` here and would win, so process_high would ask
// for 16 CPUs and fail on any smaller machine.
process {
    resourceLimits = [ cpus: 2, memory: 6.GB, time: 1.h ]
}
