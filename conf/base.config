// Default process resources. File publishing lives in the workflow `output {}`
// block in main.nf, not here.
//
// The nf-mod-* modules declare `label 'process_low'` etc. but ship no resource
// definitions of their own, so without these withLabel blocks every labelled
// process silently falls back to the 1 CPU / 4 GB default.

process {
    cpus   = 1
    memory = 4.GB
    time   = 1.h

    withLabel: process_low {
        cpus   = 2
        memory = 8.GB
        time   = 4.h
    }
    withLabel: process_medium {
        cpus   = 8
        memory = 32.GB
        time   = 8.h
    }
    withLabel: process_high {
        cpus   = 16
        memory = 64.GB
        time   = 24.h
    }

    // Measured, not guessed: bases2fastq_quick ran every full AVITI run on
    // sandpit-tokyo with 8 CPUs / 32 GB, the longest in 2 h 13 min. Its label,
    // process_high, asks for 16 CPUs, i.e. a whole 16-core tokyo node, which
    // the shared `cpu` partition rarely has free, so the task sat pending.
    withName: 'BASES2FASTQ' {
        cpus   = 8
        memory = 32.GB
        time   = 12.h
    }

    // Dorado is the only genuinely GPU-accelerated tool in this pipeline;
    // everything else (bases2fastq, FastQC, samtools, MultiQC, ONT_SUMMARY_STATS) is
    // CPU-only, so putting it in a CUDA image would cost image size for nothing.
    // The module carries no label, so resources are set by name here.
    // `containerOptions` is profile-specific — see nextflow.config.
    withName: 'DORADO_BASECALLER' {
        accelerator = 1
        cpus        = 8
        memory      = 32.GB
        time        = 24.h
        // Dorado tasks starting together on one node could race on Intel
        // OpenMP's start-up file in the shared /dev/shm and abort: exit 134
        // (`OMP: Error #15`) or 135 (bus error). The singularity and cluster
        // profiles prevent it with `--contain` (see nextflow.config and
        // EIT-GBI/nf-seqc#10); one retry stays as a fallback for other launch
        // set-ups. Only one, because 134 is any abort: a genuine dorado crash
        // late in a long run should not cost two more attempts.
        errorStrategy = { task.exitStatus in [134, 135] && task.attempt <= 1 ? 'retry' : 'terminate' }
        maxRetries    = 1
    }
    // CPU-only: splits already-classified reads by their BC tag. One task per
    // flow cell reads and writes all of its reads.
    withName: 'DORADO_DEMUX' {
        cpus   = 8
        memory = 16.GB
        time   = 12.h
    }
}
