// Container images, assigned by process name, for modules that do not pin
// their own.
//
// Released nf-mod-* repos (fastqc, samtools) ship conf/module.config with an
// image tagged to the module version; nextflow.config includes those, so they
// are not listed here. Move a module out of this file once it has a release.

process {
    // nf-mod-dorado is built and published but has no release yet, so only
    // `latest` exists. Replace with its conf/module.config once it is tagged.
    withName: 'DORADO_BASECALLER' {
        container = 'ghcr.io/eit-gbi/nf-mod-dorado:latest'
    }

    // Built from modules/local/interop/Dockerfile — the Illumina InterOp Python
    // bindings plus numpy/matplotlib, which no public image bundles.
    // WARNING: not published yet; this tag does not resolve. See the Dockerfile.
    withName: 'INTEROP_RUN_METRICS' {
        container = 'ghcr.io/eit-gbi/nf-mod-interop:latest'
    }

    // Third-party images for the remaining modules/local/ tools. TODO: verify
    // each tag resolves before the first real run — biocontainer build suffixes
    // and the Element release tag were not confirmed against the registries.
    withName: 'BASES2FASTQ' {
        container = 'elembio/bases2fastq:2.1.0'
    }
    withName: 'NANOPLOT' {
        container = 'quay.io/biocontainers/nanoplot:1.43.0--pyhdfd78af_0'
    }
    withName: 'MULTIQC' {
        container = 'quay.io/biocontainers/multiqc:1.25.1--pyhdfd78af_0'
    }
}
